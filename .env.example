# App
# Copy this file to .env and fill the empty secret values before running Docker Compose.
APP_NAME=RepoGuard AI
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

# Docker host ports
# Set NGINX_HOST_PORT=8080 if Apache/IIS already owns localhost:80.
NGINX_HOST_PORT=80
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# PostgreSQL
# Default Docker compose flow uses an existing PostgreSQL outside Docker.
# Use host.docker.internal from containers, localhost when running uvicorn directly.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=repoguard_ai
POSTGRES_USER=repoguard
POSTGRES_PASSWORD=
DATABASE_URL=
POSTGRES_URL=

# MongoDB
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_HOST_PORT=27018
MONGODB_DB=repoguard_ai
MONGODB_USER=repoguard
MONGODB_PASSWORD=
MONGO_URL=
MONGODB_URL=

# Redis and Celery
# Default Docker compose flow uses an existing Redis outside Docker.
# For hosted Redis/Upstash, use the same rediss:// URL for REDIS_URL
# and both CELERY_* URLs.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://host.docker.internal:6379/0
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5.0
REDIS_SOCKET_TIMEOUT_SECONDS=5.0
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
CELERY_BROKER_URL=redis://host.docker.internal:6379/0
CELERY_RESULT_BACKEND=redis://host.docker.internal:6379/0

# Sandbox cleanup
SANDBOX_ROOT=./.sandbox
SANDBOX_TTL_HOURS=1
FIX_EXECUTOR_DOCKER_EXECUTABLE=docker
FIX_EXECUTOR_IMAGE=repoguard-fix-executor:latest
# Set this to the Docker volume backing SANDBOX_ROOT when the worker runs in Docker.
FIX_EXECUTOR_WORKSPACE_VOLUME=
FIX_EXECUTOR_NETWORK=none
FIX_EXECUTOR_MEMORY_MB=1024
FIX_EXECUTOR_CPU_LIMIT=1.0
FIX_EXECUTOR_PIDS_LIMIT=256

# Auth
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE=15
REFRESH_TOKEN_EXPIRE=7
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ACCESS_COOKIE_NAME=accessToken
REFRESH_COOKIE_NAME=refreshToken
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# CORS
# Through Nginx, the frontend calls /api on the same origin, so CORS is not used.
# Keep localhost:3000 here for direct Next.js dev server calls.
CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|[0-9]{1,3}(\.[0-9]{1,3}){3}):300[0-9]$

# Frontend
API_PROXY_TARGET=http://backend:8000
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_API_BASE_URL=/api
FRONTEND_BASE_URL=http://localhost:3000

# GitHub App publishing
# Create the app from https://github.com/settings/apps/new, then set this to
# https://github.com/apps/<app-slug>/installations/new
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALL_URL=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Optional endpoint for OpenAI-compatible providers such as ClinePass.
OPENAI_BASE_URL=https://api.cline.bot/api/v1
OPENAI_MODEL=cline-pass/qwen3.7-plus
# Previous OpenAI default:
# OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_RETRIES=6
OPENAI_MIN_REQUEST_INTERVAL_SECONDS=1.5
# AI judge tuning. Start at 1; use 2 after validating provider rate limits.
PROBE_JUDGE_MAX_CONCURRENCY=1
PROBE_JUDGE_MAX_PROBES_PER_BATCH=8
PROBE_JUDGE_MAX_CHUNKS_PER_BATCH=24
PROBE_RETRIEVAL_MAX_CHUNKS=256
LLM_JOB_CALL_BUDGET=96
LLM_RATE_LIMIT_FAILURE_BUDGET=1
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# RAG
# Keep defaults unless you want ChromaDB persisted somewhere else.
RAG_CHROMA_PATH=.chroma
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CODE_EMBEDDING_PROVIDER=mistral
CODE_EMBEDDING_MODEL=codestral-embed-2505
CODE_EMBEDDING_DIMENSION=1536
CODE_EMBEDDING_BATCH_SIZE=16
PROBE_SEMANTIC_QUERY_BATCH_SIZE=16
PROBE_SEMANTIC_MAX_QUERY_TOKENS=64
PROBE_DEFECT_MAX_CHUNKS=120
PROBE_COVERAGE_MAX_CHUNKS=24
PROBE_ROADMAP_MAX_CHUNKS=120
CODE_EMBEDDING_MAX_ITEM_TOKENS=1500
CODE_EMBEDDING_MAX_BATCH_TOKENS=12000
CODE_EMBEDDING_MAX_CONCURRENCY=2
CODE_EMBEDDING_MAX_PENDING_BATCHES=4
CODE_CHUNK_PARSE_CONCURRENCY=4
MONGODB_CHUNK_BATCH_SIZE=500
CODE_EMBEDDING_MAX_RETRIES=4
CODE_EMBEDDING_RETRY_BASE_DELAY_SECONDS=2.0
ENABLE_CODE_SEMANTIC_SEARCH=true
