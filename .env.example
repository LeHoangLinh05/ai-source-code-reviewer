APP_NAME=RepoGuard AI
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=repoguard_ai
POSTGRES_USER=repoguard
POSTGRES_PASSWORD=change-me
POSTGRES_URL=postgresql+asyncpg://repoguard:change-me@postgres:5432/repoguard_ai

MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DB=repoguard_ai
MONGODB_USER=repoguard
MONGODB_PASSWORD=change-me
MONGODB_URL=mongodb://repoguard:change-me@mongodb:27017/repoguard_ai

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

JWT_SECRET_KEY=change-me-use-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

LLM_PROVIDER=gemini
GEMINI_API_KEY=change-me
OPENAI_API_KEY=

